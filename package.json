{
	"name": "react-native-bones",
	"version": "0.0.0",
	"description": "Skeleton loaders measured from your real React Native UI: render sample data, get matching bones with one synced shimmer.",
	"license": "MIT",
	"author": "Scholar",
	"keywords": [
		"react-native",
		"expo",
		"skeleton",
		"skeleton-loader",
		"placeholder",
		"shimmer",
		"loading",
		"skia",
		"reanimated"
	],
	"source": "./src/index.ts",
	"main": "./lib/module/index.js",
	"types": "./lib/typescript/src/index.d.ts",
	"react-native": "./src/index.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./lib/typescript/src/index.d.ts",
			"default": "./lib/module/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"lib",
		"!**/__tests__",
		"!**/*.test.*",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"scripts": {
		"build": "bob build",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "bun test",
		"prepare": "bob build",
		"example": "bun --cwd example start"
	},
	"peerDependencies": {
		"@shopify/react-native-skia": ">=2.0.0",
		"react": ">=19.0.0",
		"react-native": ">=0.79.0",
		"react-native-reanimated": ">=4.0.0",
		"react-native-worklets": ">=0.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@shopify/react-native-skia": "2.14.0",
		"@types/react": "~19.3.0",
		"react": "19.3.1",
		"react-native": "0.88.1",
		"react-native-builder-bob": "0.44.1",
		"react-native-reanimated": "4.7.1",
		"react-native-worklets": "0.13.1",
		"typescript": "~6.0.3"
	},
	"react-native-builder-bob": {
		"source": "src",
		"output": "lib",
		"targets": [
			[
				"module",
				{
					"esm": true
				}
			],
			[
				"typescript",
				{
					"project": "tsconfig.build.json"
				}
			]
		]
	}
}
